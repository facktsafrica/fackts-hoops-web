diff --git a/app/components/FacktsMotionSystem.tsx b/app/components/FacktsMotionSystem.tsx
new file mode 100644
index 0000000..61019e9
--- /dev/null
+++ b/app/components/FacktsMotionSystem.tsx
@@ -0,0 +1,131 @@
+"use client";
+
+import { useEffect } from "react";
+import { usePathname } from "next/navigation";
+
+const REVEAL_SELECTOR = [
+  "main section",
+  "main article",
+  "main li",
+  "main table tbody tr",
+  "main [class*='rounded-2xl']",
+  "main [class*='rounded-3xl']",
+].join(",");
+
+const NUMBER_PARENT_SELECTOR = "h1,h2,h3,h4,p,span,strong,td,th,dd,button";
+const COUNTABLE_NUMBER = /^(-?\d{1,6}(?:,\d{3})*(?:\.\d+)?)(%|\+)?$/;
+
+function animateNumber(element: HTMLElement) {
+  if (element.dataset.counted === "true") return;
+
+  const original = element.textContent?.trim() ?? "";
+  const match = original.match(COUNTABLE_NUMBER);
+  if (!match) return;
+
+  const target = Number(match[1].replaceAll(",", ""));
+  if (!Number.isFinite(target)) return;
+
+  const decimals = match[1].includes(".") ? match[1].split(".")[1]?.length ?? 0 : 0;
+  const suffix = match[2] ?? "";
+  const usesCommas = match[1].includes(",");
+  const duration = Math.min(1250, Math.max(480, Math.abs(target) * 24));
+  const startedAt = performance.now();
+
+  element.dataset.counted = "true";
+  element.classList.add("fackts-counting");
+
+  const format = (value: number) => {
+    const fixed = value.toFixed(decimals);
+    if (!usesCommas) return fixed;
+    const [whole, fraction] = fixed.split(".");
+    const formattedWhole = Number(whole).toLocaleString("en-US");
+    return fraction ? `${formattedWhole}.${fraction}` : formattedWhole;
+  };
+
+  const frame = (now: number) => {
+    const progress = Math.min(1, (now - startedAt) / duration);
+    const eased = 1 - Math.pow(1 - progress, 3);
+    element.textContent = `${format(target * eased)}${suffix}`;
+
+    if (progress < 1) {
+      requestAnimationFrame(frame);
+      return;
+    }
+
+    element.textContent = original;
+    element.classList.remove("fackts-counting");
+    element.classList.add("fackts-counted");
+  };
+
+  requestAnimationFrame(frame);
+}
+
+export default function FacktsMotionSystem() {
+  const pathname = usePathname();
+
+  useEffect(() => {
+    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
+
+    let scheduled = false;
+
+    const revealObserver = new IntersectionObserver(
+      (entries) => {
+        entries.forEach((entry) => {
+          if (!entry.isIntersecting) return;
+          (entry.target as HTMLElement).dataset.motionVisible = "true";
+          revealObserver.unobserve(entry.target);
+        });
+      },
+      { rootMargin: "0px 0px -7% 0px", threshold: 0.08 }
+    );
+
+    const numberObserver = new IntersectionObserver(
+      (entries) => {
+        entries.forEach((entry) => {
+          if (!entry.isIntersecting) return;
+          animateNumber(entry.target as HTMLElement);
+          numberObserver.unobserve(entry.target);
+        });
+      },
+      { threshold: 0.35 }
+    );
+
+    const prepare = () => {
+      scheduled = false;
+
+      document.querySelectorAll<HTMLElement>(REVEAL_SELECTOR).forEach((item, index) => {
+        if (item.dataset.motionReady === "true") return;
+        item.dataset.motionReady = "true";
+        item.style.setProperty("--fackts-motion-delay", `${(index % 8) * 42}ms`);
+        revealObserver.observe(item);
+      });
+
+      document.querySelectorAll<HTMLElement>(NUMBER_PARENT_SELECTOR).forEach((element) => {
+        if (element.children.length > 0) return;
+        if (element.closest("nav,aside,form,[role='dialog'],[data-no-count-up]")) return;
+        if (!COUNTABLE_NUMBER.test(element.textContent?.trim() ?? "")) return;
+        if (element.dataset.countObserved === "true") return;
+        element.dataset.countObserved = "true";
+        numberObserver.observe(element);
+      });
+    };
+
+    const schedulePrepare = () => {
+      if (scheduled) return;
+      scheduled = true;
+      requestAnimationFrame(prepare);
+    };
+
+    const mutationObserver = new MutationObserver(schedulePrepare);
+    mutationObserver.observe(document.body, { childList: true, subtree: true });
+    prepare();
+
+    return () => {
+      revealObserver.disconnect();
+      numberObserver.disconnect();
+      mutationObserver.disconnect();
+    };
+  }, [pathname]);
+
+  return null;
+}
